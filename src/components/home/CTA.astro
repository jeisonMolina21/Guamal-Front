---
import './CTA.css';
---

<section class="relative py-24 bg-guamal-green overflow-hidden">
  <div class="absolute inset-0">
    <img 
      src="https://images.unsplash.com/photo-1501785888041-af3ef285b470?q=80&w=2070&auto=format&fit=crop" 
      alt="Amanecer llanero" 
      class="w-full h-full object-cover opacity-20"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-guamal-green via-guamal-green/80 to-transparent"></div>
  </div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2 class="text-4xl md:text-5xl font-serif font-bold text-white mb-6">
        ¿Listo para desconectarte?
      </h2>
      <p class="text-xl text-guamal-cream/90 mb-10 font-light">
        Consulta disponibilidad y encuentra la casa ideal para tu estadía.
      </p>
      
      <div class="flex flex-wrap gap-4">
        <button 
          id="cta-book-btn"
          class="bg-white hover:bg-gray-50 text-guamal-green px-8 py-4 rounded-full font-medium transition-all shadow-lg hover:shadow-xl flex items-center gap-2 cursor-pointer"
        >
          Consultar disponibilidad
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </div>
    </div>
  </div>
  
  <script>
    import { isBookingModalOpen } from '../../store/uiStore';
    
    function initCTA() {
      const ctaBtn = document.getElementById('cta-book-btn');
      if (ctaBtn) {
        ctaBtn.onclick = (e) => {
          e.preventDefault();
          isBookingModalOpen.set(true);
        };
      }
    }

    initCTA();
    document.addEventListener('astro:page-load', initCTA);
  </script>
</section>
