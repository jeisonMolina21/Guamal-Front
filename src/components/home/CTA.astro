---
import { ArrowRight, MessageSquare } from 'lucide-astro';
import { SITE } from '../../config/site';
---

<section class="relative bg-[#12201C] text-[#F4F0E8] px-6 sm:px-10 lg:px-16 py-28 lg:py-40">
  <div class="mx-auto max-w-[1420px]" data-reveal>
    <h2 class="font-serif font-light text-5xl sm:text-6xl lg:text-8xl leading-[1.02] tracking-tight text-balance max-w-4xl">
      ¿Listo para desconectarte<br />
      <span class="font-editorial-italic font-normal text-white/70">en Villa MCJ?</span>
    </h2>

    <p class="mt-8 max-w-md text-base sm:text-lg font-light leading-relaxed text-white/75">
      Consulta fechas en tiempo real o escríbenos por WhatsApp.
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-4">
      <button
        id="cta-book-btn"
        class="btn-editorial inline-flex items-center gap-3 rounded-full bg-[#F4F0E8] px-8 py-4 text-sm font-semibold text-[#12201C] hover:bg-white cursor-pointer"
      >
        <span>Consultar disponibilidad</span>
        <ArrowRight size={16} />
      </button>

      <a
        href={`https://wa.me/${SITE.whatsapp}?text=Hola,%20quisiera%20asesoria%20para%20reservar%20en%20Villa%20MCJ%20Guamal`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-editorial inline-flex items-center gap-2 rounded-full border border-white/25 px-7 py-4 text-sm font-medium text-white hover:bg-white/10"
      >
        <MessageSquare size={16} />
        <span>Escribir por WhatsApp</span>
      </a>
    </div>

    <dl class="mt-16 flex flex-wrap gap-x-12 gap-y-4 border-t border-white/15 pt-6 text-sm font-light text-white/65">
      <div><dt class="sr-only">Ubicación</dt><dd>Sector campestre vía Humadea, Guamal, Meta</dd></div>
      <div><dt class="sr-only">Horarios</dt><dd>Check-in 3:00 PM, check-out 1:00 PM</dd></div>
      <div><dt class="sr-only">Reserva</dt><dd>Reserva directa con confirmación inmediata</dd></div>
    </dl>
  </div>
</section>

<script>
  import { isBookingModalOpen } from '../../store/uiStore';
  document.getElementById('cta-book-btn')?.addEventListener('click', () => {
    isBookingModalOpen.set(true);
  });
</script>
