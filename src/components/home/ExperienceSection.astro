---
/**
 * @fileoverview La villa (Experiencia)
 * @description Una foto a sangre con parallax, una frase y cuatro líneas. Sin tarjetas.
 * Lo práctico (parqueadero, WiFi, aire, acceso) va en una sola frase al final.
 */
import { ParallaxPhoto } from '../editorial/ParallaxPhoto';

const MOMENTS = [
  { title: 'Piscina y solárium', desc: 'Agua cristalina entre jardines nativos.' },
  { title: 'Kiosco BBQ criollo', desc: 'Asados a la leña y sancocho al aire libre.' },
  { title: 'Hamacas con brisa de cordillera', desc: 'Descanso profundo, sin ruido.' },
  { title: 'Río Humadea a 10 minutos', desc: 'Los balnearios más conocidos del Meta.' },
];
---

<section
  id="experiencia"
  class="relative w-full min-h-[720px] lg:min-h-screen bg-[#070A09] text-[#F4F0E8] flex items-center px-6 sm:px-10 lg:px-16 py-24 lg:py-0 overflow-hidden"
>
  <ParallaxPhoto
    client:visible
    src="https://images.unsplash.com/photo-1540541338287-41700207dee6?q=80&w=1600&auto=format&fit=crop"
    alt="Piscina campestre y solárium rodeado de jardines autóctonos en Villa MCJ"
  />
  <div class="absolute inset-0 bg-[#070A09]/55 pointer-events-none"></div>
  <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-[#070A09] to-transparent pointer-events-none"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1420px] grid lg:grid-cols-12 gap-14 lg:gap-8 items-center">
    <h2 class="lg:col-span-6 font-serif font-light text-4xl sm:text-5xl lg:text-[3.6rem] leading-[1.06] tracking-tight text-balance">
      Días de sol y agua cristalina.<br />
      <span class="font-editorial-italic font-normal">Noches de brisa fresca y fogata.</span>
    </h2>

    <div class="lg:col-span-5 lg:col-start-8">
      <ul class="border-b border-white/20">
        {MOMENTS.map((m, i) => (
          <li data-reveal style={`--reveal-i:${i}`} class="border-t border-white/20 py-5">
            <h3 class="font-serif text-xl sm:text-2xl font-normal leading-snug">{m.title}</h3>
            <p class="mt-1 text-sm sm:text-base font-light text-white/75">{m.desc}</p>
          </li>
        ))}
      </ul>
      <p data-reveal style="--reveal-i:4" class="mt-6 text-sm font-light leading-relaxed text-white/65 max-w-md">
        También: parqueadero privado, WiFi, aire acondicionado y acceso pavimentado.
      </p>
    </div>
  </div>
</section>
