---
import { Users, Bed, Bath, ArrowRight, Check, Sparkles, Wind, Eye, Utensils } from 'lucide-astro';
import { SITE } from '../../config/site';

/**
 * Verified cabins data matching database & real architecture of Villa MCJ.
 */
const cabins = [
  {
    id: "1",
    name: "Casa Ceiba",
    tagline: "Intimidad & Frescura Campestre",
    audience: "Parejas o familias de hasta 4 personas",
    image: "/hero-cabanas.jpg",
    capacity: "4 huéspedes",
    bedrooms: "2 alcobas",
    bathrooms: "1 baño privado",
    price: "$180.000",
    features: [
      "Terraza privada con hamacas",
      "Cocina semi-dotada",
      "Aire acondicionado silencioso",
      "Frente al solárium y piscina"
    ],
    editorialNote: "Orientada para capturar las corrientes de aire fresco que bajan de la cordillera al atardecer."
  },
  {
    id: "2",
    name: "Casa Samán",
    tagline: "Amplitud & Conexión Natural",
    audience: "Familias y grupos de amigos (5 personas)",
    image: "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?q=80&w=1200&auto=format&fit=crop",
    capacity: "5 huéspedes",
    bedrooms: "2 alcobas amplias",
    bathrooms: "1 baño completo",
    price: "$200.000",
    features: [
      "Sala abierta con vista a vegetación",
      "Comedor exterior cubierto",
      "Hamaca doble tradicional",
      "Smart TV con WiFi fibra óptica"
    ],
    editorialNote: "Nuestra cabaña más solicitada por su equilibrio entre espacio social exterior y frescura interior."
  },
  {
    id: "3",
    name: "Casa Moriche",
    tagline: "La Cabaña Insignia con Zona BBQ",
    audience: "Grupos familiares de hasta 6 personas",
    image: "https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?q=80&w=1200&auto=format&fit=crop",
    capacity: "6 huéspedes",
    bedrooms: "3 alcobas independientes",
    bathrooms: "2 baños completos",
    price: "$250.000",
    features: [
      "Kiosco asador BBQ privado",
      "Nevera grande y menaje completo",
      "3 habitaciones independientes",
      "Terraza mirador panorámica"
    ],
    editorialNote: "Diseñada para celebraciones íntimas y fines de semana largos con asado criollo privado."
  }
];
---

<section class="py-32 bg-[#FAF7F2] relative overflow-hidden" id="alojamiento">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header: Editorial & Atmospheric -->
    <div class="max-w-3xl mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#142723]/5 border border-[#142723]/10 text-[#142723] text-xs font-bold uppercase tracking-[0.16em] mb-4">
        <Sparkles size={13} class="text-[#C69A59]" />
        Colección de Hospedaje
      </div>
      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-serif font-bold text-[#142723] leading-[1.08] tracking-tight">
        Tres cabañas independientes. <br />
        <span class="font-editorial-italic font-normal text-[#1E3A34]">Un solo propósito: descansar sin afán.</span>
      </h2>
      <p class="text-base sm:text-lg text-gray-600 mt-6 font-light leading-relaxed">
        Construidas con arquitectura bioclimática para mantener temperaturas agradables en el interior, con áreas de hamacas privadas y acceso total a las zonas húmedas de Villa MCJ.
      </p>
    </div>

    <!-- Asymmetrical Editorial Layout: 1 Featured Full-Width + 2 Half-Grid -->
    <div class="space-y-12">
      
      <!-- Cabin 1: Casa Ceiba (Full-width editorial stage with real project photo) -->
      <article class="bg-white rounded-3xl overflow-hidden border border-[#C4B9A7]/40 shadow-xl grid grid-cols-1 lg:grid-cols-12 transition-[transform,box-shadow] duration-500 [transition-timing-function:cubic-bezier(0.23,1,0.32,1)] hover:-translate-y-1 hover:shadow-2xl">
        
        {/* Large Media with Photo */}
        <div class="lg:col-span-7 relative min-h-[380px] sm:min-h-[460px] overflow-hidden group">
          <img 
            src={cabins[0].image} 
            alt="Cabaña Casa Ceiba en Villa MCJ" 
            class="w-full h-full object-cover transition-transform duration-700 [transition-timing-function:cubic-bezier(0.23,1,0.32,1)] group-hover:scale-[1.03]"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          
          <div class="absolute top-6 left-6">
            <span class="px-4 py-1.5 rounded-full bg-[#142723]/90 text-white text-xs font-bold uppercase tracking-wider backdrop-blur-md">
              Fotografía Real de Villa MCJ
            </span>
          </div>

          <div class="absolute bottom-6 left-6 right-6 text-white flex items-end justify-between">
            <div>
              <span class="text-xs uppercase tracking-[0.2em] text-[#E0BA80]">Cabaña 01</span>
              <h3 class="text-3xl sm:text-4xl font-serif font-bold">{cabins[0].name}</h3>
            </div>
            <div class="text-right">
              <span class="text-xs text-white/80 block">Tarifa por noche</span>
              <span class="text-2xl sm:text-3xl font-serif font-bold text-[#E0BA80]">{cabins[0].price}</span>
            </div>
          </div>
        </div>

        {/* Content details */}
        <div class="lg:col-span-5 p-8 sm:p-12 flex flex-col justify-between bg-white">
          <div>
            <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#C69A59] mb-3">
              <span>{cabins[0].tagline}</span>
            </div>

            <p class="text-sm sm:text-base text-gray-700 font-light leading-relaxed mb-6">
              {cabins[0].audience}. {cabins[0].editorialNote}
            </p>

            {/* Quick Specs */}
            <div class="grid grid-cols-3 gap-2 py-4 border-y border-gray-100 text-xs font-medium text-gray-800 mb-6 text-center">
              <div>
                <span class="text-gray-400 block text-[10px] uppercase">Capacidad</span>
                <span class="font-bold">{cabins[0].capacity}</span>
              </div>
              <div class="border-x border-gray-100">
                <span class="text-gray-400 block text-[10px] uppercase">Distribución</span>
                <span class="font-bold">{cabins[0].bedrooms}</span>
              </div>
              <div>
                <span class="text-gray-400 block text-[10px] uppercase">Baño</span>
                <span class="font-bold">{cabins[0].bathrooms}</span>
              </div>
            </div>

            {/* Inclusions */}
            <ul class="space-y-2.5 text-xs text-gray-600 mb-8">
              {cabins[0].features.map(f => (
                <li class="flex items-center gap-2.5">
                  <span class="w-4 h-4 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center shrink-0">
                    <Check size={11} />
                  </span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="flex items-center gap-4">
            <a 
              href={`/alojamiento/${cabins[0].id}`}
              class="flex-1 py-4 rounded-2xl bg-[#1E3A34] hover:bg-[#142723] text-white text-xs font-bold uppercase tracking-wider text-center transition-all active:scale-95 shadow-md flex items-center justify-center gap-2"
            >
              <span>Ver Ficha Detallada</span>
              <ArrowRight size={14} />
            </a>
          </div>

        </div>

      </article>

      <!-- Cabins 2 & 3: Editorial Double Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        {/* Casa Samán */}
        <article class="bg-white rounded-3xl overflow-hidden border border-[#C4B9A7]/40 shadow-xl flex flex-col justify-between transition-[transform,box-shadow] duration-500 [transition-timing-function:cubic-bezier(0.23,1,0.32,1)] hover:-translate-y-1 hover:shadow-2xl">
          <div>
            <div class="relative aspect-[16/10] overflow-hidden group">
              <img 
                src={cabins[1].image} 
                alt={cabins[1].name} 
                class="w-full h-full object-cover transition-transform duration-700 [transition-timing-function:cubic-bezier(0.23,1,0.32,1)] group-hover:scale-[1.03]"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
              
              <div class="absolute top-4 left-4">
                <span class="px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-white text-[11px] font-bold uppercase tracking-wider">
                  Cabaña 02 • Más Popular
                </span>
              </div>

              <div class="absolute bottom-4 left-6 right-6 text-white flex items-baseline justify-between">
                <h3 class="text-2xl font-serif font-bold">{cabins[1].name}</h3>
                <span class="text-xl font-serif font-bold text-[#E0BA80]">{cabins[1].price}</span>
              </div>
            </div>

            <div class="p-6 sm:p-8">
              <span class="text-xs font-bold uppercase tracking-wider text-[#C69A59] block mb-2">
                {cabins[1].tagline}
              </span>
              <p class="text-xs sm:text-sm text-gray-600 font-light leading-relaxed mb-6">
                {cabins[1].audience}. {cabins[1].editorialNote}
              </p>

              <div class="flex items-center justify-between py-3 px-4 bg-gray-50 rounded-2xl text-xs font-semibold text-gray-800 mb-6">
                <span>{cabins[1].capacity}</span>
                <span>•</span>
                <span>{cabins[1].bedrooms}</span>
                <span>•</span>
                <span>{cabins[1].bathrooms}</span>
              </div>

              <ul class="space-y-2 text-xs text-gray-600">
                {cabins[1].features.map(f => (
                  <li class="flex items-center gap-2">
                    <Check size={13} className="text-emerald-700 shrink-0" />
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="p-6 sm:p-8 pt-0">
            <a 
              href={`/alojamiento/${cabins[1].id}`}
              class="w-full py-3.5 rounded-2xl bg-[#1E3A34] hover:bg-[#142723] text-white text-xs font-bold uppercase tracking-wider text-center transition-all flex items-center justify-center gap-2"
            >
              <span>Consultar Casa Samán</span>
              <ArrowRight size={14} />
            </a>
          </div>
        </article>

        {/* Casa Moriche */}
        <article class="bg-white rounded-3xl overflow-hidden border border-[#C4B9A7]/40 shadow-xl flex flex-col justify-between transition-[transform,box-shadow] duration-500 [transition-timing-function:cubic-bezier(0.23,1,0.32,1)] hover:-translate-y-1 hover:shadow-2xl">
          <div>
            <div class="relative aspect-[16/10] overflow-hidden group">
              <img 
                src={cabins[2].image} 
                alt={cabins[2].name} 
                class="w-full h-full object-cover transition-transform duration-700 [transition-timing-function:cubic-bezier(0.23,1,0.32,1)] group-hover:scale-[1.03]"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
              
              <div class="absolute top-4 left-4">
                <span class="px-3 py-1 rounded-full bg-[#C69A59] text-[#142723] text-[11px] font-bold uppercase tracking-wider shadow">
                  Cabaña 03 • Con Asador BBQ
                </span>
              </div>

              <div class="absolute bottom-4 left-6 right-6 text-white flex items-baseline justify-between">
                <h3 class="text-2xl font-serif font-bold">{cabins[2].name}</h3>
                <span class="text-xl font-serif font-bold text-[#E0BA80]">{cabins[2].price}</span>
              </div>
            </div>

            <div class="p-6 sm:p-8">
              <span class="text-xs font-bold uppercase tracking-wider text-[#C69A59] block mb-2">
                {cabins[2].tagline}
              </span>
              <p class="text-xs sm:text-sm text-gray-600 font-light leading-relaxed mb-6">
                {cabins[2].audience}. {cabins[2].editorialNote}
              </p>

              <div class="flex items-center justify-between py-3 px-4 bg-gray-50 rounded-2xl text-xs font-semibold text-gray-800 mb-6">
                <span>{cabins[2].capacity}</span>
                <span>•</span>
                <span>{cabins[2].bedrooms}</span>
                <span>•</span>
                <span>{cabins[2].bathrooms}</span>
              </div>

              <ul class="space-y-2 text-xs text-gray-600">
                {cabins[2].features.map(f => (
                  <li class="flex items-center gap-2">
                    <Check size={13} className="text-emerald-700 shrink-0" />
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="p-6 sm:p-8 pt-0">
            <a 
              href={`/alojamiento/${cabins[2].id}`}
              class="w-full py-3.5 rounded-2xl bg-[#1E3A34] hover:bg-[#142723] text-white text-xs font-bold uppercase tracking-wider text-center transition-all flex items-center justify-center gap-2"
            >
              <span>Consultar Casa Moriche</span>
              <ArrowRight size={14} />
            </a>
          </div>
        </article>

      </div>

    </div>

    {/* Complete Mini-Barrio Privatization Banner */}
    <div class="mt-16 p-8 sm:p-12 rounded-3xl bg-[#142723] text-white relative overflow-hidden shadow-2xl flex flex-col lg:flex-row items-center justify-between gap-8">
      <div class="relative z-10 max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#E0BA80] block mb-2">
          Opción Exclusiva para Familias & Empresas
        </span>
        <h3 class="text-3xl sm:text-4xl font-serif font-bold text-white mb-3">
          Reserva el Mini Barrio Completo
        </h3>
        <p class="text-white/80 text-sm sm:text-base font-light leading-relaxed">
          Las 3 cabañas, la piscina, el kiosco BBQ y los senderos cerrados exclusivamente para tu grupo de hasta 15 personas. Privacidad absoluta sin extraños en el predio.
        </p>
      </div>

      <div class="relative z-10 shrink-0 flex flex-col sm:flex-row items-center gap-4">
        <div class="text-right hidden sm:block">
          <span class="text-xs text-white/70 block">Paquete Integral</span>
          <span class="text-2xl font-serif font-bold text-[#E0BA80]">$535.000 / noche</span>
        </div>

        <a
          href={`https://wa.me/${SITE.whatsapp}?text=Hola,%20deseo%20cotizar%20el%20alquiler%20exclusivo%20de%20todo%20el%20Mini%20Barrio%20en%20Villa%20MCJ`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 rounded-full bg-[#C69A59] hover:bg-[#b58947] text-[#142723] font-bold text-xs uppercase tracking-wider transition-all duration-300 shadow-lg active:scale-95 text-center"
        >
          Cotizar Alquiler Total
        </a>
      </div>
    </div>

  </div>
</section>
