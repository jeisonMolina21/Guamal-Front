---
/**
 * @fileoverview Subcomponente de Galería Viva en Guamal
 * @description Muestra una cuadrícula de 4 postales fotográficas con enlace a la galería completa.
 */
const galleryImages = [
  {
    url: "https://images.unsplash.com/photo-1587061949409-02df41d5e562?q=80&w=800&auto=format&fit=crop",
    caption: "Cabañas entre el bosque nativo"
  },
  {
    url: "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?q=80&w=800&auto=format&fit=crop",
    caption: "Interiores cálidos y bioclimáticos"
  },
  {
    url: "https://images.unsplash.com/photo-1540541338287-41700207dee6?q=80&w=800&auto=format&fit=crop",
    caption: "Solárium y piscina campestre"
  },
  {
    url: "https://images.unsplash.com/photo-1510798831971-661eb04b3739?q=80&w=800&auto=format&fit=crop",
    caption: "Atardeceres frente a la cordillera"
  }
];
---

<section class="w-full bg-[#FAF7F2] text-[#12201C] py-20 sm:py-24 px-6 sm:px-10 lg:px-14 border-t border-[#12201C]/10" id="galeria-viva">
  <div class="max-w-[1420px] mx-auto">
    
    {/* Header de la Galería */}
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-10 sm:mb-12 gap-6">
      <div class="max-w-2xl">
        <span class="text-[11px] font-sans font-medium tracking-[0.25em] text-[#12201C]/60 uppercase block mb-2">
          Galería
        </span>
        <h3 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-light text-[#12201C] leading-[1.08] tracking-tight">
          Así se vive <span class="font-editorial-italic font-normal text-[#12201C]">en Guamal</span>
        </h3>
        <p class="text-[#12201C]/75 text-sm sm:text-base font-light font-sans mt-3 max-w-xl leading-relaxed">
          Conoce más sobre nuestro refugio campestre y todo lo que tenemos para ti.
        </p>
      </div>

      <div>
        <a 
          href="/galeria" 
          class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full border border-[#12201C]/20 hover:border-[#12201C] text-[#12201C] hover:bg-[#12201C] hover:text-[#F4F0E8] transition-all duration-300 text-xs font-semibold uppercase tracking-wider shadow-sm group cursor-pointer"
        >
          <span>Ver galería completa</span>
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>

    {/* Cuadrícula de 4 Fotografías */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {galleryImages.map((item) => (
        <a 
          href="/galeria"
          class="aspect-[4/3] rounded-2xl overflow-hidden relative border border-[#12201C]/10 shadow-md group cursor-pointer block bg-[#12201C]/5"
        >
          <img 
            src={item.url} 
            alt={item.caption} 
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" 
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent opacity-60 group-hover:opacity-90 transition-opacity"></div>
          <div class="absolute bottom-3 left-4 right-4 pointer-events-none">
            <span class="text-xs text-white/95 font-serif font-light block line-clamp-1">
              {item.caption}
            </span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
