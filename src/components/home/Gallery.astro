---
import './Gallery.css';

const galleryImages = [
  "https://images.unsplash.com/photo-1587061949409-02df41d5e562?q=80&w=600&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?q=80&w=600&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1540541338287-41700207dee6?q=80&w=600&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1510798831971-661eb04b3739?q=80&w=600&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1588880331179-bc9b93a8cb65?q=80&w=600&auto=format&fit=crop"
];
---

<section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
      <div class="max-w-2xl">
        <span class="text-xs font-bold tracking-widest text-guamal-green uppercase mb-3 block">Galería</span>
        <h2 class="text-4xl md:text-5xl font-serif font-bold text-guamal-green mb-4">Así se vive en Guamal</h2>
        <p class="text-guamal-text/80 text-lg">
          Conoce más sobre nuestro mini barrio hostal y todo lo que tenemos para ti.
        </p>
      </div>
      <div>
        <a href="/galeria" class="inline-flex items-center justify-center px-6 py-3 border border-guamal-green text-base font-medium rounded-full text-guamal-green hover:bg-guamal-green hover:text-white transition-colors">
          Ver galería completa
        </a>
      </div>
    </div>

    <div class="flex gap-4 overflow-x-auto pb-8 snap-x snap-mandatory scrollbar-hide" style="scrollbar-width: none;">
      {galleryImages.map((img, i) => (
        <div class={`flex-none w-64 md:w-80 aspect-[4/3] rounded-2xl overflow-hidden shadow-sm snap-center ${i === 0 ? 'ml-0' : ''}`}>
          <img src={img} alt={`Galería ${i+1}`} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
        </div>
      ))}
    </div>
  </div>
</section>
