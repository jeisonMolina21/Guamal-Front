---
import { ArrowRight, ChevronDown } from 'lucide-astro';
---

<section class="relative h-screen min-h-[700px] flex flex-col justify-between pt-28 pb-16 overflow-hidden bg-[#070B0A]">
  
  <!-- Backing Image: Full view, natural light and cinematic pan -->
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-gradient-to-t from-[#070B0A] via-transparent to-black/35 z-10"></div>
    <div class="absolute inset-0 bg-black/15 z-10"></div>
    
    <img 
      src="/hero-cabanas.jpg" 
      alt="Cabañas y piscina reales en Villa MCJ, Guamal, Meta" 
      class="w-full h-full object-cover object-center animate-film-pan filter brightness-[0.98] contrast-[1.04]"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <!-- Empty top spacer for total breathing room -->
  <div class="relative z-20"></div>

  <!-- Bottom Stage: Clean, Minimalist & Focused on photography -->
  <div class="relative z-20 max-w-7xl mx-auto px-6 sm:px-10 lg:px-12 w-full pb-14 sm:pb-16">
    <div class="max-w-3xl">
      
      <!-- Subtle location pill -->
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-black/30 backdrop-blur-md border border-white/20 text-white text-[11px] font-medium tracking-[0.2em] uppercase mb-6 shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-white/90 animate-pulse"></span>
        <span>Guamal, Meta • Refugio Campestre</span>
      </div>

      <!-- Clean, powerful headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-[4.75rem] font-serif font-bold text-white leading-[1.04] tracking-tight mb-6 drop-shadow-[0_4px_24px_rgba(0,0,0,0.6)]">
        El descanso que mereces <br class="hidden sm:inline" />
        en el <span class="font-editorial-italic font-normal text-white/80">corazón del llano.</span>
      </h1>

      <p class="text-base sm:text-xl text-white/90 max-w-xl font-light leading-relaxed mb-8 drop-shadow-[0_2px_10px_rgba(0,0,0,0.7)] text-balance-editorial">
        Cabañas bioclimáticas privadas, piscina cristalina y senderos naturales a solo 10 minutos de los balnearios de Río Humadea.
      </p>

      <!-- Minimalist Call to Action -->
      <div class="flex flex-wrap items-center gap-4">
        <button
          id="hero-book-btn"
          class="px-8 py-4 rounded-full bg-white hover:bg-white/90 text-[#070B0A] font-bold text-xs uppercase tracking-[0.16em] transition-all duration-300 shadow-[0_8px_30px_rgba(255,255,255,0.18)] active:scale-95 flex items-center gap-2.5 cursor-pointer"
        >
          <span>Reservar Cabaña</span>
          <ArrowRight size={15} />
        </button>

        <a
          href="#alojamiento"
          class="px-6 py-4 rounded-full bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 text-white font-medium text-xs uppercase tracking-[0.16em] transition-all"
        >
          <span>Ver Cabañas</span>
        </a>
      </div>

    </div>

    <!-- Minimalist bottom indicator -->
    <div class="mt-14 pt-6 border-t border-white/15 flex items-center justify-between text-white/80 text-xs">
      <div class="flex items-center gap-6">
        <span>3 Cabañas Privadas</span>
        <span>•</span>
        <span>Piscina & Solárium</span>
        <span>•</span>
        <span>Río Humadea a 10 min</span>
      </div>

      <a href="#alojamiento" class="hidden sm:flex items-center gap-1.5 text-white/70 hover:text-white transition-colors">
        <span>Explorar espacio</span>
        <ChevronDown size={14} />
      </a>
    </div>

  </div>

</section>

<script>
  import { isBookingModalOpen } from '../../store/uiStore';
  
  function initHero() {
    const btn = document.getElementById('hero-book-btn');
    if (btn) {
      btn.onclick = (e) => {
        e.preventDefault();
        isBookingModalOpen.set(true);
      };
    }
  }

  initHero();
  document.addEventListener('astro:page-load', initHero);
</script>
