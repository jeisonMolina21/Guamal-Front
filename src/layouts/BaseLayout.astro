---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { BookingModal } from '../components/booking/BookingModal';
import { ConciergeWidget } from '../components/common/ConciergeWidget';
import { AuthModal } from '../components/auth/AuthModal';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Casas privadas, tranquilidad y una experiencia para disfrutar sin afán en Guamal, Meta." } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Villa MCJ - Cabañas campestres privadas, descanso y naturaleza llanera en Guamal, Meta." />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,300;1,6..72,400;1,6..72,500;1,6..72,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Villa MCJ - Guamal, Meta</title>

    {/* OpenGraph & Social Cards */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Villa MCJ`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/hero-cabanas.jpg" />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Villa MCJ`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/hero-cabanas.jpg" />

    {/* Structured Data: Schema.org LodgingBusiness */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LodgingBusiness",
      "name": "Villa MCJ",
      "description": "Refugio campestre y cabañas bioclimáticas a orillas del río Humadea en Guamal, Meta, Colombia.",
      "image": "/hero-cabanas.jpg",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Guamal",
        "addressRegion": "Meta",
        "addressCountry": "CO"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 4.0744,
        "longitude": -73.7661
      },
      "priceRange": "COP 165.000 - 320.000"
    })} />

    <ClientRouter />
  </head>
  <body class="bg-guamal-cream text-guamal-text antialiased min-h-screen flex flex-col font-sans">
    <slot />
    
    <BookingModal client:load />
    <ConciergeWidget client:load />
    <AuthModal client:load />

    <script>
      // Entrada única y discreta: los elementos [data-reveal] aparecen una sola vez al entrar en pantalla.
      function initReveal() {
        const els = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-in)');
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.15 }
        );
        els.forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
