---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { BookingModal } from '../components/booking/BookingModal';
import { WhatsAppWidget } from '../components/common/WhatsAppWidget';
import { AuthModal } from '../components/auth/AuthModal';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Casas privadas, tranquilidad y una experiencia para disfrutar sin afán en Guamal, Meta." } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Villa MCJ - Cabañas campestres privadas, descanso y naturaleza llanera en Guamal, Meta." />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Villa MCJ - Guamal, Meta</title>
    <ClientRouter />
  </head>
  <body class="bg-guamal-cream text-guamal-text antialiased min-h-screen flex flex-col font-sans">
    <slot />
    
    <BookingModal client:load />
    <WhatsAppWidget client:load />
    <AuthModal client:load />
  </body>
</html>
