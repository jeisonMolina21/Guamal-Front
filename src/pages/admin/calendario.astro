---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { TimelineCalendar } from '../../components/admin/TimelineCalendar';
---

<AdminLayout title="Calendario de Ocupación">
  <div class="mb-6 flex justify-between items-center">
    <p class="text-gray-500">Visualiza la ocupación de todas tus casas en tiempo real.</p>
    <div class="flex gap-4 text-sm">
      <div class="flex items-center gap-2">
        <div class="w-3 h-3 rounded-full bg-guamal-green"></div>
        <span class="text-gray-600">Confirmada</span>
      </div>
      <div class="flex items-center gap-2">
        <div class="w-3 h-3 rounded-full bg-orange-200 border border-orange-300"></div>
        <span class="text-gray-600">Pendiente</span>
      </div>
    </div>
  </div>

  <TimelineCalendar client:load />
</AdminLayout>
