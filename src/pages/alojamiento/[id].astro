      'Habitación 3: 2 Camas Sencillas independientes.'
    ]
  },
  '4': {
    name: 'Cabaña Guayacán',
    subtitle: 'Refugio del bosque, sombra natural y silencio continuo',
    capacity: 4,
    bedrooms: 2,
    bathrooms: 1,
    price: 195000,
    isRealPhoto: false,
    images: [
      'https://images.unsplash.com/photo-1587061949409-02df41d5e562?q=80&w=1200&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1540541338287-41700207dee6?q=80&w=800&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1510798831971-661eb04b3739?q=80&w=800&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?q=80&w=800&auto=format&fit=crop'
    ],
    description: 'Rodeada de árboles nativos y palmas de moriche. Su diseño bioclimático aprovecha la sombra natural de la vegetación para garantizar una estancia fresca durante todo el día.',
    features: [
      'Sombra vegetal continua',
      'Terraza jardín privada con hamaca',
      'Cocina semi-dotada',
      'Aire acondicionado eficiente',
      'Acceso a piscina y solárium',
      'WiFi de alta velocidad',
      'Baño privado con toallas limpias',
      'Senderos ecológicos a la puerta'
    ],
    roomDetails: [
      'Habitación 1: 1 Cama Doble con iluminación cálida.',
      'Habitación 2: 2 Camas Sencillas con vista al jardín.'
    ]
  },
  '5': {
    name: 'Suite Yarumo',
    subtitle: 'Espacio boutique romántico con solárium privado',
    capacity: 2,
    bedrooms: 1,
    bathrooms: 1,
    price: 165000,
    isRealPhoto: false,
    images: [
      'https://images.unsplash.com/photo-1510798831971-661eb04b3739?q=80&w=1200&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1540541338287-41700207dee6?q=80&w=800&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?q=80&w=800&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1587061949409-02df41d5e562?q=80&w=800&auto=format&fit=crop'
    ],
    description: 'Concebida como un santuario íntimo para parejas que buscan descanso en total privacidad. Cuenta con cama King campestre, deck exterior de solárium y cafetera artesanal.',
    features: [
      'Deck solárium privado',
      'Cama King campestre',
      'Baño de lujo con detalles rústicos',
      'Cafetera artesanal con café de origen',
      'Aire acondicionado silencioso',
      'WiFi fibra óptica',
      'Acceso directo a zonas húmedas',
      'Silencio nocturno garantizado'
    ],
    roomDetails: [
      'Suite Principal: 1 Cama King con lencería de lujo y salida directa al deck privado.'
    ]
  },
  '6': {
    name: 'Refugio Palma Real',
    subtitle: 'Gran formato familiar con acceso directo a senderos',
    capacity: 8,
    bedrooms: 4,
    bathrooms: 2,
    price: 320000,
    isRealPhoto: false,
    images: [
      'https://images.unsplash.com/photo-1542314831-c5a4d40715af?q=80&w=1200&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1540541338287-41700207dee6?q=80&w=800&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?q=80&w=800&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1587061949409-02df41d5e562?q=80&w=800&auto=format&fit=crop'
    ],
    description: 'La estancia más amplia de Villa MCJ para encuentros familiares extendidos. Cuatro habitaciones independientes, dos baños y amplia zona de estar integrada con corredores perimetrales.',
    features: [
      'Aforo amplio de hasta 8 personas',
      '4 Habitaciones independientes',
      '2 Baños completos',
      'Cocina completa con menaje para grupos',
      'Zona social exterior con hamacas',
      'Parqueadero para múltiples vehículos',
      'WiFi fibra óptica',
      'Acceso a piscina y senderos nativos'
    ],
    roomDetails: [
      'Habitación 1: 1 Cama King con baño privado.',
      'Habitación 2: 1 Cama Queen.',
      'Habitación 3: 2 Camas Sencillas.',
      'Habitación 4: 2 Camas Sencillas.'
    ]
  }
};

const house = housesData[id || '1'] || housesData['1'];
---

<BaseLayout title={`${house.name} | Villa MCJ`}>
  <Navbar client:load />

  <main class="flex-grow pt-28 pb-32 bg-[#070B0A] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Return button */}
      <a 
        href="/#alojamiento" 
        class="inline-flex items-center gap-2 text-white/60 hover:text-white text-xs font-semibold uppercase tracking-wider mb-8 transition-colors"
      >
        <ArrowLeft size={16} />
        Volver a la colección de cabañas
      </a>

      {/* Header Row */}
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8 border-b border-white/10 pb-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/15 text-white/80 text-[10px] font-semibold tracking-widest uppercase mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Cabaña Privada en Villa MCJ
          </div>
          <h1 class="text-4xl sm:text-6xl font-serif font-bold text-white tracking-tight leading-tight">
            {house.name}
          </h1>
          <p class="text-white/70 text-base font-light mt-2 max-w-xl">
            {house.subtitle}
          </p>
        </div>

        <div class="p-4 rounded-2xl bg-white/[0.04] border border-white/10 flex items-baseline gap-2 self-start md:self-auto">
          <span class="text-3xl font-medium text-white">${house.price.toLocaleString('es-CO')}</span>
          <span class="text-white/50 text-xs font-sans uppercase tracking-wider">COP / noche</span>
        </div>
      </div>

      {/* Monumental Photography Grid (Full Bleed Hero) */}
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 rounded-[32px] overflow-hidden mb-12 shadow-[0_25px_80px_rgba(0,0,0,0.8)] border border-white/10">
        <div class="md:col-span-2 md:row-span-2 aspect-[4/3] md:aspect-auto overflow-hidden bg-black/40 relative group">
          <img 
            src={house.images[0]} 
            alt={house.name} 
            class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-700" 
          />
          {house.isRealPhoto && (
            <div class="absolute top-4 left-4 px-3 py-1 rounded-full bg-black/60 backdrop-blur-md text-[10px] text-white font-medium border border-white/20 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              Fotografía Real Verificada
            </div>
          )}
        </div>
        <div class="aspect-[4/3] overflow-hidden bg-black/40 group">
          <img src={house.images[1]} alt="Piscina y exterior" class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700" />
        </div>
        <div class="aspect-[4/3] overflow-hidden bg-black/40 group">
          <img src={house.images[2]} alt="Área social" class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700" />
        </div>
        <div class="md:col-span-2 aspect-[16/9] overflow-hidden bg-black/40 group">
          <img src={house.images[3]} alt="Naturaleza y entorno" class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700" />
        </div>
      </div>

      {/* Layout Split: Details & Sticky Booking Card */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        
        {/* Left Column (8 cols): Architecture Details */}
        <div class="lg:col-span-8 space-y-10">
          
          {/* Key Metrics Strip (Apple Style) */}
          <div class="p-6 rounded-3xl bg-white/[0.04] border border-white/10 grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
            <div>
              <span class="block text-[10px] uppercase tracking-widest text-white/40 mb-1">Capacidad</span>
              <strong class="text-base font-semibold text-white">Hasta {house.capacity} personas</strong>
            </div>
            <div>
              <span class="block text-[10px] uppercase tracking-widest text-white/40 mb-1">Alcobas</span>
              <strong class="text-base font-semibold text-white">{house.bedrooms} Habitaciones</strong>
            </div>
            <div>
              <span class="block text-[10px] uppercase tracking-widest text-white/40 mb-1">Baño</span>
              <strong class="text-base font-semibold text-white">{house.bathrooms} {house.bathrooms === 1 ? 'Privado' : 'Completos'}</strong>
            </div>
            <div>
              <span class="block text-[10px] uppercase tracking-widest text-white/40 mb-1">Río Humadea</span>
              <strong class="text-base font-semibold text-white">10 Minutos</strong>
            </div>
          </div>

          {/* Description Block */}
          <div class="p-8 sm:p-10 rounded-3xl bg-white/[0.03] border border-white/10">
            <h2 class="text-2xl font-serif font-normal text-white mb-4">Sobre esta estancia</h2>
            <p class="text-white/80 leading-relaxed text-sm sm:text-base font-light mb-8">
              {house.description}
            </p>

            <h3 class="font-serif font-normal text-lg text-white mb-4">Acomodación y distribución</h3>
            <div class="space-y-2 mb-8">
              {house.roomDetails.map(rd => (
                <div class="flex items-start gap-3 text-xs sm:text-sm text-white/70">
                  <span class="w-1.5 h-1.5 rounded-full bg-white/60 mt-2 shrink-0"></span>
                  <span>{rd}</span>
                </div>
              ))}
            </div>

            <h3 class="font-serif font-normal text-lg text-white mb-4">Servicios & Comodidades</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm text-white/80">
              {house.features.map(f => (
                <div class="flex items-center gap-3 p-3 rounded-2xl bg-white/[0.03] border border-white/5">
                  <Check size={15} class="text-emerald-400 shrink-0" />
                  <span>{f}</span>
                </div>
              ))}
            </div>
          </div>

          {/* Rules & Check-in Details */}
          <div class="p-8 rounded-3xl bg-white/[0.03] border border-white/10">
            <h3 class="text-lg font-serif font-normal text-white mb-4">Condiciones & Estancia</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-xs sm:text-sm text-white/70">
              <div class="flex items-start gap-3">
                <Clock size={18} class="text-white/80 shrink-0 mt-0.5" />
                <div>
                  <strong class="text-white block mb-0.5">Horarios Oficiales</strong>
                  <p>Check-in: 3:00 PM • Check-out: 1:00 PM</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <ShieldCheck size={18} class="text-white/80 shrink-0 mt-0.5" />
                <div>
                  <strong class="text-white block mb-0.5">Políticas de Convivencia</strong>
                  <p>Ambiente de tranquilidad, libre de ruido nocturno y 100% privado.</p>
                </div>
              </div>
            </div>
          </div>

        </div>

        {/* Right Column (4 cols): Sticky Booking Card */}
        <div class="lg:col-span-4">
          <div class="sticky top-28 p-8 rounded-3xl bg-white/[0.05] border border-white/15 backdrop-blur-2xl shadow-2xl space-y-6">
            
            <div class="border-b border-white/10 pb-4">
              <span class="text-[10px] uppercase font-bold tracking-widest text-white/40 block mb-1">Tarifa en tiempo real</span>
              <div class="flex items-baseline gap-2">
                <span class="text-3xl font-medium text-white">${house.price.toLocaleString('es-CO')}</span>
                <span class="text-xs text-white/50 uppercase tracking-wider">COP / noche</span>
              </div>
            </div>

            <div class="space-y-3 text-xs text-white/70">
              <div class="flex justify-between py-2 border-b border-white/5">
                <span>Capacidad máxima</span>
                <strong class="text-white">{house.capacity} Huéspedes</strong>
              </div>
              <div class="flex justify-between py-2 border-b border-white/5">
                <span>Acceso zonas húmedas</span>
                <strong class="text-emerald-400 font-semibold">Ilimitado</strong>
              </div>
              <div class="flex justify-between py-2 border-b border-white/5">
                <span>Parqueadero privado</span>
                <strong class="text-white">Incluido</strong>
              </div>
            </div>

            {/* Primary Action Button (Apple Crisp White) */}
            <button
              id="book-this-house-btn"
              data-id={id}
              class="w-full bg-white hover:bg-white/90 text-[#070B0A] py-4 rounded-full font-bold text-xs uppercase tracking-wider transition-all duration-200 active:scale-95 shadow-[0_6px_30px_rgba(255,255,255,0.2)] flex items-center justify-center gap-2 cursor-pointer"
            >
              <Sparkles size={16} />
              <span>Reservar {house.name}</span>
            </button>

            <a 
              href={`https://wa.me/${SITE.whatsapp}?text=Hola,%20quisiera%20consultar%20disponibilidad%20para%20la%20${encodeURIComponent(house.name)}`}
              target="_blank" 
              rel="noopener noreferrer"
              class="w-full border border-white/15 hover:border-white/30 text-white/80 hover:text-white py-3.5 rounded-full font-medium text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2"
            >
              <span>Consultar por WhatsApp</span>
            </a>

            <p class="text-[11px] text-center text-white/40 leading-relaxed">
              Disponibilidad inmediata. Confirmación y comprobantes de abono por canales oficiales.
            </p>

          </div>
        </div>

      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { isBookingModalOpen } from '../../store/uiStore';
  import { reservationStore } from '../../store/reservationStore';

  function initDetailButton() {
    const btn = document.getElementById('book-this-house-btn');
    if (btn) {
      btn.onclick = (e) => {
        e.preventDefault();
        const id = btn.getAttribute('data-id') || '1';
        reservationStore.set({
          ...reservationStore.get(),
          selectedPropertyId: id
        });
        isBookingModalOpen.set(true);
      };
    }
  }

  initDetailButton();
  document.addEventListener('astro:page-load', initDetailButton);
</script>
