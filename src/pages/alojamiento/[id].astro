---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Navbar } from '../../components/layout/Navbar';
import Footer from '../../components/layout/Footer.astro';
import { Users, Bed, Bath, Wifi, Wind, Utensils, Check, ArrowLeft, ShieldCheck, Clock, Sparkles, MapPin, Compass } from 'lucide-astro';
import { SITE } from '../../config/site';

export function getStaticPaths() {
  return [
    { params: { id: '1' } },
    { params: { id: '2' } },
    { params: { id: '3' } },
    { params: { id: '4' } },
    { params: { id: '5' } },
    { params: { id: '6' } }
  ];
}

const { id } = Astro.params;

const housesData: Record<string, {
  name: string;
  subtitle: string;
  capacity: number;
  bedrooms: number;
  bathrooms: number;
  price: number;
  isRealPhoto: boolean;
  images: string[];
  description: string;
  features: string[];
  roomDetails: string[];
}> = {
  '1': {
    name: 'Casa Ceiba',
    subtitle: 'Intimidad, frescura campestre y vista directa a la piscina',
    capacity: 4,
    bedrooms: 2,
    bathrooms: 1,
    price: 180000,
    isRealPhoto: true,
    images: [
      '/hero-cabanas.jpg',
      'https://images.unsplash.com/photo-1540541338287-41700207dee6?q=80&w=1200&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?q=80&w=800&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1587061949409-02df41d5e562?q=80&w=800&auto=format&fit=crop'
