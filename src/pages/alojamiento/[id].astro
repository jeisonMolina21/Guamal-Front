    ]
  },
  '2': {
    name: 'Casa Samán',
    subtitle: 'Amplitud, conexión natural y sala abierta al jardín',
    capacity: 5,
    bedrooms: 2,
    bathrooms: 1,
    price: 200000,
    isRealPhoto: false,
    images: [
      'https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?q=80&w=1200&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1540541338287-41700207dee6?q=80&w=800&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1510798831971-661eb04b3739?q=80&w=800&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1587061949409-02df41d5e562?q=80&w=800&auto=format&fit=crop'
    ],
    description: 'Casa Samán destaca por su frescura natural, arquitectura bioclimática y distribución que invita a compartir momentos memorables. Con un comedor exterior y sala de estar abierta, es la casa favorita para familias y grupos de amigos.',
    features: [
      'Ventilación bioclimática cruzada',
      'Conexión WiFi fibra óptica',
      'Cocina con barra integrada',
      'Comedor exterior techado con vista al jardín',
      'Acceso ilimitado a piscina y solárium',
      'Parrilla BBQ a disposición',
      'Smart TV con streaming',
      'Hamaca doble tradicional en corredor'
    ],
    roomDetails: [
      'Habitación 1: 1 Cama King con aire acondicionado silencioso.',
      'Habitación 2: 1 Cama Doble + 1 Cama Sencilla (capacidad 3 huéspedes).'
    ]
  },
  '3': {
    name: 'Casa Moriche',
    subtitle: 'La cabaña insignia con kiosco asador BBQ privado',
    capacity: 6,
    bedrooms: 3,
    bathrooms: 2,
    price: 250000,
    isRealPhoto: false,
    images: [
      'https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?q=80&w=1200&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1542314831-c5a4d40715af?q=80&w=800&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1540541338287-41700207dee6?q=80&w=800&auto=format&fit=crop',
      'https://images.unsplash.com/photo-1587061949409-02df41d5e562?q=80&w=800&auto=format&fit=crop'
    ],
    description: 'Casa Moriche es la cabaña insignia de mayor capacidad en Villa MCJ. Tres dormitorios independientes, dos baños completos y su propio kiosco BBQ para asados privados de carne a la llanera y sancocho criollo.',
    features: [
      'Kiosco asador BBQ privado',
      '3 Habitaciones independientes',
