---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Navbar } from "../../components/layout/Navbar";
import Footer from "../../components/layout/Footer.astro";
import { Users, Bed, Bath, ArrowRight, Check, Sparkles } from "lucide-astro";

const houses = [
  {
    id: "1",
    num: "01",
    name: "Casa Ceiba",
    tag: "Intimidad & Brisa de Cordillera",
    image: "/hero-cabanas.jpg",
    capacity: "4 huéspedes",
    bedrooms: "2 alcobas",
    bathrooms: "1 baño privado",
    price: "$180.000",
    isRealPhoto: true,
    description: "Cabaña bioclimática orientada hacia la ventilación natural de la cordillera. Cuenta con amplia terraza con hamacas dobles, cocina semi-dotada y acceso directo a la piscina.",
    amenities: ["WiFi fibra óptica", "Aire acondicionado silencioso", "Cocina semi-dotada", "Acceso a piscina", "Parqueadero privado", "Hamacas dobles"]
  },
  {
    id: "2",
    num: "02",
    name: "Casa Samán",
    tag: "Amplitud & Conexión Natural",
    image: "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?q=80&w=1400&auto=format&fit=crop",
    capacity: "5 huéspedes",
    bedrooms: "2 alcobas amplias",
    bathrooms: "1 baño completo",
    price: "$200.000",
    isRealPhoto: false,
    description: "Espaciosa, luminosa y con excelente ventilación cruzada. Diseñada para familias o amigos que buscan frescura y descanso profundo con sala abierta y comedor exterior cubierto.",
    amenities: ["WiFi fibra óptica", "Aire acondicionado silencioso", "Cocina con barra", "Acceso a piscina", "Zona BBQ", "Smart TV"]
  },
  {
    id: "3",
    num: "03",
    name: "Casa Moriche",
    tag: "Insignia con Kiosco BBQ Privado",
    image: "https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?q=80&w=1400&auto=format&fit=crop",
    capacity: "6 huéspedes",
    bedrooms: "3 alcobas independientes",
    bathrooms: "2 baños completos",
    price: "$250.000",
    isRealPhoto: false,
    description: "Nuestra cabaña insignia de mayor capacidad. Cuenta con su propio kiosco BBQ para asados privados a la leña, dos baños completos y terraza panorámica.",
    amenities: ["Kiosco BBQ privado", "Aire acondicionado en alcobas", "Cocina completa con nevera", "2 Baños completos", "Terraza panorámica", "Smart TV"]
  },
  {
    id: "4",
    num: "04",
    name: "Cabaña Guayacán",
    tag: "Refugio del Bosque & Sombra",
    image: "https://images.unsplash.com/photo-1587061949409-02df41d5e562?q=80&w=1400&auto=format&fit=crop",
    capacity: "4 huéspedes",
    bedrooms: "2 alcobas",
    bathrooms: "1 baño privado",
    price: "$195.000",
    isRealPhoto: false,
    description: "Rodeada de árboles nativos y palmas de moriche. Su diseño bioclimático aprovecha la sombra natural de la vegetación para garantizar frescura todo el día.",
    amenities: ["Sombra vegetal continua", "Terraza jardín privada", "Cocina equipada", "Acceso a piscina", "WiFi fibra óptica", "Hamaca tradicional"]
  },
  {
    id: "5",
    num: "05",
    name: "Suite Yarumo",
    tag: "Romance & Solárium Privado",
    image: "https://images.unsplash.com/photo-1510798831971-661eb04b3739?q=80&w=1400&auto=format&fit=crop",
    capacity: "2 huéspedes",
    bedrooms: "1 suite king",
    bathrooms: "1 baño de lujo",
    price: "$165.000",
    isRealPhoto: false,
    description: "Concebida como un santuario íntimo para parejas que buscan descanso en total privacidad. Cama King campestre, solárium privado y cafetera artesanal.",
    amenities: ["Deck solárium privado", "Cama King campestre", "Cafetera artesanal", "Baño en piedra rústica", "Silencio absoluto", "WiFi fibra óptica"]
  },
  {
    id: "6",
    num: "06",
    name: "Refugio Palma Real",
    tag: "Gran Formato Familiar & Social",
    image: "https://images.unsplash.com/photo-1542314831-c5a4d40715af?q=80&w=1400&auto=format&fit=crop",
    capacity: "8 huéspedes",
    bedrooms: "4 habitaciones",
    bathrooms: "2 baños amplios",
    price: "$320.000",
    isRealPhoto: false,
    description: "La estancia más amplia de Villa MCJ para encuentros familiares extendidos. Cuatro habitaciones independientes, dos baños y amplia zona social exterior.",
    amenities: ["Capacidad hasta 8 personas", "4 Habitaciones", "2 Baños completos", "Menaje familiar completo", "Senderos directos", "Parqueadero múltiple"]
  }
];
---

<BaseLayout title="Colección de Cabañas | Villa MCJ">
  <Navbar client:load />

  <main class="flex-grow pt-32 pb-32 bg-[#070B0A] text-white">
    
    <!-- Hero Header: Pure Architectural Editorial -->
    <div class="max-w-5xl mx-auto px-6 sm:px-8 text-center mb-24">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/10 border border-white/15 text-white/80 text-[10px] font-semibold tracking-[0.2em] uppercase mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        Colección Completa de Hospedaje
      </div>
      <h1 class="text-4xl sm:text-6xl font-serif font-bold text-white leading-[1.08] tracking-tight mb-6">
        Cabañas & refugios campestres <br />
        <span class="font-editorial-italic font-normal text-white/70">para vivir el llano a tu propio ritmo.</span>
      </h1>
      <p class="text-sm sm:text-base text-white/70 font-light max-w-2xl mx-auto leading-relaxed">
        Espacios concebidos para el silencio y la desconexión. Construidas con arquitectura bioclimática para garantizar una estancia fresca y natural.
      </p>
    </div>

    <!-- Editorial Cards Feed -->
    <div class="max-w-6xl mx-auto px-6 sm:px-8 space-y-24">
      {houses.map((house, idx) => (
        <article class={`grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center ${idx % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
          
          {/* Photography side (7 cols) */}
          <div class={`lg:col-span-7 relative rounded-[32px] overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.8)] border border-white/10 group ${idx % 2 === 1 ? 'lg:order-2' : ''}`}>
            <div class="aspect-[16/11] overflow-hidden bg-black/40">
              <img 
                src={house.image} 
                alt={house.name} 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
                loading="lazy"
              />
            </div>
            
            <div class="absolute top-5 left-5 flex items-center gap-2">
              <span class="px-3.5 py-1 rounded-full bg-black/60 backdrop-blur-md text-white text-[10px] font-mono border border-white/15">
                {house.num}
              </span>
              <span class="px-3.5 py-1 rounded-full bg-black/60 backdrop-blur-md text-white/90 text-[10px] font-semibold uppercase tracking-wider border border-white/15">
                {house.tag}
              </span>
              {house.isRealPhoto && (
                <span class="px-3 py-1 rounded-full bg-emerald-950/80 backdrop-blur-md text-emerald-300 text-[10px] font-medium border border-emerald-500/30 flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  Foto Real
                </span>
              )}
            </div>

            <div class="absolute bottom-5 right-5 px-4 py-2 rounded-2xl bg-black/70 backdrop-blur-md border border-white/15 text-white">
              <span class="text-xs text-white/50 block text-right font-sans uppercase tracking-widest text-[9px]">Tarifa</span>
              <span class="font-serif text-lg font-bold">{house.price}</span>
              <span class="text-[10px] text-white/50 uppercase ml-1">/ noche</span>
            </div>
          </div>

          {/* Editorial info side (5 cols) */}
          <div class={`lg:col-span-5 space-y-6 ${idx % 2 === 1 ? 'lg:order-1' : ''}`}>
            <div>
              <h2 class="text-3xl sm:text-4xl font-serif font-bold text-white tracking-tight mb-2">
                {house.name}
              </h2>
              <p class="text-white/70 text-sm font-light leading-relaxed">
                {house.description}
              </p>
            </div>

            {/* Micro specs */}
            <div class="flex items-center gap-6 py-4 border-t border-b border-white/10 text-white/90 text-xs">
              <div>
                <span class="block text-[9px] uppercase tracking-widest text-white/40 mb-0.5">Aforo</span>
                <strong class="text-sm font-semibold text-white">{house.capacity}</strong>
              </div>
              <div class="w-px h-6 bg-white/15"></div>
              <div>
                <span class="block text-[9px] uppercase tracking-widest text-white/40 mb-0.5">Alcobas</span>
                <strong class="text-sm font-semibold text-white">{house.bedrooms}</strong>
              </div>
              <div class="w-px h-6 bg-white/15"></div>
              <div>
                <span class="block text-[9px] uppercase tracking-widest text-white/40 mb-0.5">Baño</span>
                <strong class="text-sm font-semibold text-white">{house.bathrooms}</strong>
              </div>
            </div>

            {/* Amenities tags */}
            <div class="flex flex-wrap gap-2">
              {house.amenities.map(am => (
                <span class="px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 text-white/70 text-[11px]">
                  {am}
                </span>
              ))}
            </div>

            {/* Actions */}
            <div class="flex items-center gap-4 pt-2">
              <a 
                href={`/alojamiento/${house.id}`}
                class="px-6 py-3.5 rounded-full bg-white hover:bg-white/90 text-[#070B0A] font-bold text-xs uppercase tracking-wider transition-all duration-200 active:scale-95 shadow-md flex items-center gap-2"
              >
                <span>Ver Cabaña & Reservar</span>
                <ArrowRight size={14} />
              </a>
            </div>
          </div>

        </article>
      ))}
    </div>

  </main>

  <Footer />
</BaseLayout>
