---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Navbar } from '../components/layout/Navbar';
import Footer from '../components/layout/Footer.astro';
import { Waves, Flame, Leaf, Compass, Sparkles, ArrowRight } from 'lucide-astro';

const experiences = [
  {
    title: "Piscina & Solárium entre Palmeras",
    tagline: "Frescura & Calma",
    description: "Nuestra piscina es un remanso de agua cristalina rodeada de jardines nativos. Diseñada para refrescarse durante las tardes soleadas del piedemonte y descansar en cómodas tumbonas con sombra natural.",
    image: "https://images.unsplash.com/photo-1540541338287-41700207dee6?q=80&w=1200&auto=format&fit=crop",
    detail: "Zona húmeda privada • Apta para familias y niños"
  },
  {
    title: "Asados Criollos en el Kiosco BBQ",
    tagline: "Tradición Llanera",
    description: "Instalaciones completamente equipadas para preparar cortes al carbón o leña. El punto de reunión perfecto para compartir historias, carnes asadas y sobremesas sin afán al caer la tarde.",
    image: "https://images.unsplash.com/photo-1555939594-58d7cb561ad1?q=80&w=1200&auto=format&fit=crop",
    detail: "Parrilla campestre • Mesas amplias al aire libre"
  },
  {
    title: "Tardes de Hamaca & Brisa Pura",
    tagline: "Desconexión Consciente",
    description: "Siente la brisa continua que desciende de la cordillera al atardecer. Cada cabaña cuenta con corredores exteriores con hamacas dobles tradicionales para leer, meditar o tomar una siesta reparadora.",
    image: "https://images.unsplash.com/photo-1588880331179-bc9b93a8cb65?q=80&w=1200&auto=format&fit=crop",
    detail: "Hamacas tejidas dobles • Silencio y cantos de aves"
  },
  {
    title: "Balnearios y Pozos de Río Humadea",
    tagline: "A 10 min de Villa MCJ",
    description: "A solo diez minutos en vehículo se encuentran las aguas transparentes y templadas de Río Humadea, sus balnearios naturales de piedra y quioscos gastronómicos donde degustar sancocho criollo y pescado fresco.",
    image: "https://images.unsplash.com/photo-1544644181-1484b3fdfc62?q=80&w=1200&auto=format&fit=crop",
    detail: "Aguas del Sumapaz • Paseos de olla tradicionales"
  }
];
---

<BaseLayout title="Experiencia | Villa MCJ">
  <Navbar client:load tone="light" />

  <main class="flex-grow pt-32 pb-28 bg-[#FAF7F2]">
    
    <!-- Header -->
    <div class="max-w-4xl mx-auto px-6 sm:px-8 text-center mb-24">
      <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#142723]/5 border border-[#142723]/10 text-[#142723] text-xs font-bold uppercase tracking-[0.16em] mb-4">
        <Sparkles size={13} class="text-[#C69A59]" />
        La Experiencia en Villa MCJ
      </span>
      <h1 class="text-4xl sm:text-6xl font-serif font-bold text-[#142723] leading-[1.08] tracking-tight mb-6">
        Tiempo para contemplar, <br />
        <span class="font-editorial-italic font-normal text-[#1E3A34]">descansar y reencontrarse.</span>
      </h1>
      <p class="text-base sm:text-lg text-gray-600 font-light max-w-2xl mx-auto leading-relaxed">
        Lejos del ruido urbano y las pantallas. En Villa MCJ cada momento está pensado para que disfrutes del sol, el agua pura y la calidez llanera.
      </p>
    </div>

    <!-- Editorial Staggered Feed -->
    <div class="max-w-6xl mx-auto px-6 sm:px-8 space-y-24">
      {experiences.map((exp, idx) => (
        <article class={`grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center ${idx % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
          
          <div class={`lg:col-span-7 relative rounded-3xl overflow-hidden shadow-xl border border-[#C4B9A7]/30 group ${idx % 2 === 1 ? 'lg:order-2' : ''}`}>
            <div class="aspect-[16/11] overflow-hidden">
              <img 
                src={exp.image} 
                alt={exp.title} 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-103"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
            </div>

            <div class="absolute top-5 left-5">
              <span class="px-3.5 py-1 rounded-full bg-[#142723]/85 backdrop-blur-md text-white text-[11px] font-bold uppercase tracking-wider">
                {exp.tagline}
              </span>
            </div>
          </div>

          <div class={`lg:col-span-5 space-y-6 ${idx % 2 === 1 ? 'lg:order-1' : ''}`}>
            <div>
              <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#C69A59]">
                0{idx + 1} • Experiencia
              </span>
              <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[#142723] mt-1">
                {exp.title}
              </h2>
            </div>

            <p class="text-sm sm:text-base text-gray-600 font-light leading-relaxed">
              {exp.description}
            </p>

            <div class="pt-4 border-t border-gray-200/70 text-xs font-semibold text-[#1E3A34] flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#C69A59]"></span>
              <span>{exp.detail}</span>
            </div>
          </div>

        </article>
      ))}
    </div>

  </main>

  <Footer />
</BaseLayout>
