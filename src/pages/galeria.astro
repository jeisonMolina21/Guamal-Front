---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Navbar } from '../components/layout/Navbar';
import Footer from '../components/layout/Footer.astro';
import { Camera, Sparkles } from 'lucide-astro';

const galleryPhotos = [
  {
    title: "Cabañas campestres en Villa MCJ",
    category: "Cabañas",
    src: "/hero-cabanas.jpg",
    span: "col-span-12 md:col-span-8 aspect-[16/10]"
  },
  {
    title: "Piscina central y vegetación nativa",
    category: "Piscina",
    src: "https://images.unsplash.com/photo-1540541338287-41700207dee6?q=80&w=1200&auto=format&fit=crop",
    span: "col-span-12 md:col-span-4 aspect-[4/5]"
  },
  {
    title: "Corredor exterior con hamacas tradicionales",
    category: "Descanso",
    src: "https://images.unsplash.com/photo-1588880331179-bc9b93a8cb65?q=80&w=1200&auto=format&fit=crop",
    span: "col-span-12 md:col-span-4 aspect-[4/5]"
  },
  {
    title: "Aguas cristalinas de Río Humadea (A 10 min)",
    category: "Entorno",
    src: "https://images.unsplash.com/photo-1544644181-1484b3fdfc62?q=80&w=1200&auto=format&fit=crop",
    span: "col-span-12 md:col-span-8 aspect-[16/10]"
  },
  {
    title: "Atardecer dorado sobre las sabanas de Guamal",
    category: "Paisajes",
    src: "https://images.unsplash.com/photo-1501785888041-af3ef285b470?q=80&w=1200&auto=format&fit=crop",
    span: "col-span-12 md:col-span-6 aspect-[16/10]"
  },
  {
    title: "Cascadas y senderismo en el piedemonte",
    category: "Ecoturismo",
    src: "https://images.unsplash.com/photo-1432405972618-c60b0225b8f9?q=80&w=1200&auto=format&fit=crop",
    span: "col-span-12 md:col-span-6 aspect-[16/10]"
  }
];
---

<BaseLayout title="Galería | Villa MCJ">
  <Navbar client:load />

  <main class="flex-grow pt-32 pb-28 bg-[#FAF7F2]">
    
    <!-- Header -->
    <div class="max-w-4xl mx-auto px-6 sm:px-8 text-center mb-20">
      <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#142723]/5 border border-[#142723]/10 text-[#142723] text-xs font-bold uppercase tracking-[0.16em] mb-4">
        <Camera size={13} class="text-[#C69A59]" />
        Memoria Visual de Villa MCJ
      </span>
      <h1 class="text-4xl sm:text-6xl font-serif font-bold text-[#142723] leading-[1.08] tracking-tight mb-6">
        Así transcurren los días <br />
        <span class="font-editorial-italic font-normal text-[#1E3A34]">en nuestro refugio.</span>
      </h1>
      <p class="text-base sm:text-lg text-gray-600 font-light max-w-2xl mx-auto leading-relaxed">
        Postales de calma, arquitectura en armonía con la tierra y rincones naturales del Meta.
      </p>
    </div>

    <!-- Calm Editorial Masonry Grid -->
    <div class="max-w-6xl mx-auto px-6 sm:px-8">
      <div class="grid grid-cols-12 gap-8">
        {galleryPhotos.map((photo) => (
          <div class={`${photo.span} group relative rounded-3xl overflow-hidden shadow-lg border border-[#C4B9A7]/30 bg-black/10`}>
            <img 
              src={photo.src} 
              alt={photo.title}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-104"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

            <div class="absolute bottom-5 left-5 right-5 text-white transform translate-y-2 group-hover:translate-y-0 opacity-0 group-hover:opacity-100 transition-all duration-300">
              <span class="text-[10px] uppercase font-bold tracking-widest text-[#E0BA80] block mb-1">
                {photo.category}
              </span>
              <h3 class="text-base sm:text-lg font-serif font-bold text-white">
                {photo.title}
              </h3>
            </div>
          </div>
        ))}
      </div>
    </div>

  </main>

  <Footer />
</BaseLayout>
