---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Navbar } from '../components/layout/Navbar';
import Footer from '../components/layout/Footer.astro';
import { SmoothScroll } from '../components/editorial/SmoothScroll';
import { CustomCursor } from '../components/editorial/CustomCursor';
import { Scene1Apertura } from '../components/editorial/Scene1Apertura';
import { Scene3Cabanas } from '../components/editorial/Scene3Cabanas';
import { DestinationExplorer } from '../components/home/DestinationExplorer';
import ExperienceSection from '../components/home/ExperienceSection.astro';
import Gallery from '../components/home/Gallery.astro';
import CTA from '../components/home/CTA.astro';
---

<BaseLayout title="Villa MCJ • Refugio en Guamal, Meta">
  <SmoothScroll client:load />
  <CustomCursor client:load />
  <Navbar client:load />
  
  <main class="flex-grow">
    <!-- ESCENA 1: Apertura (Inicia con la frase poética editorial y se abre del centro a los bordes con física Apple) -->
    <Scene1Apertura client:load />

    <!-- ESCENA 3: Las Cabañas (Pinned con scroll horizontal & clip-path wipe mask entre estancias a pantalla completa) -->
    <Scene3Cabanas client:load />

    <!-- Resto de secciones previas (A la espera de aprobación para implementar Escenas 4, 5 y 6) -->
    <div id="resto-de-la-villa">
      <DestinationExplorer client:load />
      <ExperienceSection />
      <Gallery />
      <CTA />
    </div>
  </main>
  
  <Footer />
</BaseLayout>
