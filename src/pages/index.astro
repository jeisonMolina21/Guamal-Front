---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Navbar } from '../components/layout/Navbar';
import Footer from '../components/layout/Footer.astro';
import { SmoothScroll } from '../components/editorial/SmoothScroll';
import { CustomCursor } from '../components/editorial/CustomCursor';
import { Scene1Apertura } from '../components/editorial/Scene1Apertura';
import { Scene3Cabanas } from '../components/editorial/Scene3Cabanas';
import { DestinationExplorer } from '../components/home/DestinationExplorer';
import ExperienceSection from '../components/home/ExperienceSection.astro';
import Gallery from '../components/home/Gallery.astro';
import CTA from '../components/home/CTA.astro';
---

<BaseLayout title="Villa MCJ • Refugio en Guamal, Meta">
  <SmoothScroll client:load />
  <CustomCursor client:load />
  <Navbar client:load tone="light" />
  
  <main class="flex-grow">
    <!-- ESCENA 1: Apertura (Inicia con la frase poética editorial y se abre del centro a los bordes con física Apple) -->
    <Scene1Apertura client:load />

    <!-- ESCENA 3: Las Cabañas (Pantalla completa con auto-avance cada 5s & wipe) -->
    <Scene3Cabanas client:load />

    <!-- ESCENA 4: La Vida en Villa MCJ (Single-Screen: Foto grande a la izq con título superpuesto + Grilla 2x4 a la der) -->
    <ExperienceSection />

    <!-- ESCENA 5: Destinos Reales en Guamal -->
    <section class="py-20 sm:py-28 bg-[#070A09] text-[#F4F0E8] relative overflow-hidden" id="destinos-guamal">
      {/* Luz ambiental natural */}
      <div class="absolute top-1/4 left-1/4 w-[600px] h-[600px] bg-emerald-500/[0.04] rounded-full blur-[160px] pointer-events-none"></div>
      <div class="absolute bottom-1/4 right-10 w-[500px] h-[500px] bg-white/[0.015] rounded-full blur-[140px] pointer-events-none"></div>

      <div class="max-w-[1420px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <DestinationExplorer client:visible />
      </div>
    </section>

    <!-- Componente: Galería Viva de Guamal -->
    <Gallery />

    <!-- Cierre / CTA -->
    <CTA />
  </main>
  
  <Footer />
</BaseLayout>
