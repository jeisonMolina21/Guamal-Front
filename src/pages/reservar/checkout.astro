---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Navbar } from '../../components/layout/Navbar';
import Footer from '../../components/layout/Footer.astro';
import { CheckoutForm } from '../../components/booking/CheckoutForm';
import { BookingSummary } from '../../components/booking/BookingSummary';
---

<BaseLayout title="Completar Reserva | Villa MCJ">
  <Navbar client:load />
  
  <main class="relative min-h-screen pt-32 pb-32 bg-[#070B0A] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-12 border-b border-white/10 pb-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/15 text-white/80 text-[10px] font-semibold tracking-widest uppercase mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          Reserva Segura • Villa MCJ
        </div>
        <h1 class="text-3xl sm:text-5xl font-serif font-bold text-white mb-2">Completa tu Solicitud</h1>
        <p class="text-white/60 text-sm font-light">Ingresa tus datos personales para formalizar tu estadía.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        <div class="lg:col-span-7">
          <div class="p-6 sm:p-8 rounded-3xl bg-white/[0.03] border border-white/10 shadow-xl">
            <CheckoutForm client:load />
          </div>
        </div>
        
        <div class="lg:col-span-5">
          <div class="sticky top-28">
            <BookingSummary client:load />
          </div>
        </div>
      </div>

    </div>
  </main>
  
  <Footer />
</BaseLayout>
