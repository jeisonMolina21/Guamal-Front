---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Navbar } from '../../components/layout/Navbar';
import Footer from '../../components/layout/Footer.astro';
import { CheckoutForm } from '../../components/booking/CheckoutForm';
import { BookingSummary } from '../../components/booking/BookingSummary';
---

<BaseLayout title="Completar Reserva">
  <Navbar client:load />
  
  <main class="relative min-h-screen pt-32 pb-24">
    <div class="absolute inset-0 z-0 fixed">
      <img src="https://images.unsplash.com/photo-1623057000041-356ec32ce89c?q=80&w=2000&auto=format&fit=crop" alt="Background" class="w-full h-full object-cover opacity-30" />
      <div class="absolute inset-0 bg-gradient-to-b from-gray-50/90 via-gray-50/80 to-gray-50/90 backdrop-blur-sm"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12 border-b border-gray-200/50 pb-6">
        <h1 class="text-4xl font-serif font-bold text-guamal-green mb-2 drop-shadow-sm">Completa tu Solicitud</h1>
        <p class="text-gray-600 text-lg">Falta poco. Ingresa tus datos para generar la reserva.</p>
      </div>

      <div class="flex flex-col lg:flex-row gap-10">
        <div class="lg:w-2/3">
          <CheckoutForm client:load />
        </div>
        
        <div class="lg:w-1/3">
          <div class="sticky top-32">
            <BookingSummary client:load />
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
