---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Navbar } from '../../components/layout/Navbar';
import Footer from '../../components/layout/Footer.astro';
import { CheckCircle2, MessageSquare, ArrowRight } from 'lucide-astro';
import { SITE } from '../../config/site';
---

<BaseLayout title="Reserva Registrada | Villa MCJ">
  <Navbar client:load />
  
  <main class="flex-grow pt-32 pb-32 bg-[#070B0A] text-white min-h-screen flex items-center">
    <div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <div class="p-8 sm:p-12 rounded-[32px] bg-white/[0.04] border border-white/10 shadow-[0_25px_80px_rgba(0,0,0,0.85)]">
        <div class="w-20 h-20 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded-full flex items-center justify-center mx-auto mb-6">
          <CheckCircle2 size={40} />
        </div>
        
        <h1 class="text-3xl sm:text-4xl font-serif font-bold text-white mb-3">
          ¡Reserva Solicitada!
        </h1>
        
        <p class="text-sm text-white/70 mb-8 font-light leading-relaxed">
          Hemos recibido tu solicitud de reserva en Villa MCJ. En breve recibirás la confirmación oficial con el itinerario de llegada y datos de ingreso.
        </p>

        <div class="p-6 rounded-2xl bg-white/[0.03] border border-white/5 text-left mb-8 space-y-3">
          <h3 class="text-xs uppercase font-bold tracking-widest text-white/50">¿Qué sigue ahora?</h3>
          <ul class="space-y-2.5 text-xs text-white/80">
            <li class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mt-1.5 shrink-0"></span>
              <span>Revisa tu WhatsApp. Nuestro asistente oficial o anfitrión te enviará el resumen.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mt-1.5 shrink-0"></span>
              <span>Formaliza el abono del 50% para asegurar el bloqueo de la cabaña.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mt-1.5 shrink-0"></span>
              <span>¡Todo listo para descansar en el corazón de Guamal, Meta!</span>
            </li>
          </ul>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a 
            href={`https://wa.me/${SITE.whatsapp}?text=Hola,%20acabo%20de%20solicitar%20una%20reserva%20en%20Villa%20MCJ`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3.5 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2"
          >
            <MessageSquare size={14} />
            <span>Hablar con Anfitrión</span>
          </a>

          <a 
            href="/" 
            class="px-6 py-3.5 rounded-full bg-white hover:bg-white/90 text-[#070B0A] font-bold text-xs uppercase tracking-wider transition-all"
          >
            <span>Volver al Inicio</span>
          </a>
        </div>
      </div>

    </div>
  </main>
  
  <Footer />
</BaseLayout>
